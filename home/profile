append_path () {
    case ":$PATH:" in
        *:"$1":*)
            ;;
        *)
            PATH="${PATH:+$PATH:}$1"
    esac
}

append_path /usr/local/sbin
append_path /usr/local/bin
append_path /usr/sbin
append_path /usr/bin
append_path /sbin
append_path /bin
append_path ~/.local/bin
append_path ~/node_modules/.bin
append_path ~/bin

export PATH
