include=~/.cache/matugen/mako.conf

font=Inter 11
width=360
height=160
margin=16
padding=16
border-size=2
border-radius=14
icons=1
max-icon-size=48
icon-border-radius=10
default-timeout=7000
ignore-timeout=0
max-visible=5
max-history=20
group-by=app-name
layer=overlay
anchor=top-right
on-button-left=invoke-default-action
on-button-middle=dismiss
on-button-right=dismiss

[mode=do-not-disturb]
invisible=1
on-notify=none
