#!/bin/sh

cd "$(dirname "$0")" || exit

for conf in $(exec find -- */ -type f)
do
    case "$conf" in
        ./img/*)
            ;;
        ./home/*)
            ln -snfv "$(realpath "$conf")" ~/."$(basename "$conf")"
            ;;
        *)
            mkdir -p ~/."$(dirname "$conf")"
            ln -snfv "$(realpath "$conf")" ~/."$conf"
            ;;
    esac
done
